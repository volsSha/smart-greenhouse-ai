# Smart Greenhouse production environment template
# Copy this file to .env on the server and replace every placeholder there.
# Do not commit real secrets.

COMPOSE_PROJECT_NAME=greenhouse

# Public application URL
API_BASE_URL=https://greenhouse.volsh.dev
DEBUG=false
APP_SECRET=replace-with-long-random-secret

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=greenhouse_user
POSTGRES_PASSWORD=replace-with-production-postgres-password
POSTGRES_DB=greenhouse_db

# InfluxDB
INFLUX_URL=http://influxdb:8086
INFLUX_PASSWORD=replace-with-production-influx-admin-password
INFLUX_TOKEN=replace-with-production-influx-token
INFLUX_ORG=greenhouse_org
INFLUX_BUCKET=microclimate

# MQTT
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=app
MQTT_PASSWORD=replace-with-production-mqtt-app-password
MQTT_PASSWORD_FILE=./secrets/mosquitto_passwords

# OpenRouter
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSION=1536

# Nginx / TLS / temporary access gate
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_CERTS_DIR=./certs
NGINX_HTPASSWD_FILE=./secrets/nginx.htpasswd
