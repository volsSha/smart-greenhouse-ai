# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=greenhouse_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=greenhouse_db

# InfluxDB
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influxdb-token
INFLUX_ORG=greenhouse_org
INFLUX_BUCKET=microclimate

# MQTT (Mosquitto)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=greenhouse_client
MQTT_PASSWORD=changeme

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# App
APP_SECRET=your-app-secret-here
DEBUG=true

# OpenRouter Embedding Model (fixed - changing requires RAG reindex)
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMENSION=1536

#ngrock
